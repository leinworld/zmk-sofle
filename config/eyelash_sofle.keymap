#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&lt { tapping-term-ms = <350>; };

&mt { tapping-term-ms = <350>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    tlt: tlt {
        compatible = "zmk,behavior-hold-tap";
        label = "TabPreferedLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <350>;
        quick-tap-ms = <160>;
        flavor = "tap-preferred";
        retro-tap;
    };

    hlt: hlt {
        compatible = "zmk,behavior-hold-tap";
        label = "HoldPreferedTap";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <150>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        mo3 {
            bindings = <&mo 3>;
            key-positions = <56 57>;
        };

        OslLayer {
            bindings = <&sl 4>;
            key-positions = <28 29>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <30 29>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <43 42>;
        };

        Undo {
            bindings = <&kp LC(Z)>;
            key-positions = <40 41>;
        };

        Redo {
            bindings = <&kp LC(Y)>;
            key-positions = <27 28>;
        };

        select_all {
            bindings = <&kp LC(A)>;
            key-positions = <26 27>;
        };

        combo_del {
            bindings = <&kp DELETE>;
            key-positions = <16 17>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <30 28>;
        };

        vsrh {
            bindings = <&mo 5>;
            key-positions = <15 16>;
        };

        backtick {
            bindings = <&kp GRAVE>;
            key-positions = <41 42>;
        };

        toggle_gaming {
            bindings = <&tog 6>;
            key-positions = <27 28 29 30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESCAPE  &kp N1  &kp N2        &kp N3     &kp N4        &kp N5          &msc SCRL_UP     &kp N6     &kp N7        &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp ESCAPE  &kp Q   &kp W         &kp E      &kp R         &kp T           &msc SCRL_DOWN   &kp Y      &kp U         &kp I      &kp O    &kp P     &kp BACKSPACE
&kp TAB     &kp A   &kp S         &kp D      &kp F         &kp G           &msc SCRL_LEFT   &kp H      &kp J         &kp K      &kp L    &kp SEMI  &mt LEFT_ALT SQT
&kp LSHFT   &kp Z   &kp X         &kp C      &kp V         &kp B           &msc SCRL_RIGHT  &kp N      &kp M         &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
&kp C_MUTE  &none   &kp LEFT_ALT  &kp LCTRL  &tlt 1 SPACE  &kp LEFT_GUI    &mkp MB3         &kp ENTER  &tlt 2 SPACE  &none      &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
            label = "Base";
        };

        NavAndFunction {
            bindings = <
&kp GRAVE  &kp LC(S)  &kp LC(LS(S))  &trans   &trans   &trans                 &trans                  &trans             &trans    &trans         &trans     &trans           &trans
&kp GRAVE  &kp F1     &kp F2         &kp F3   &kp F4   &kp F13                &trans                  &kp C_VOLUME_UP    &kp HOME  &kp PG_UP      &kp INS    &kp PRINTSCREEN  &kp DEL
&trans     &kp F5     &kp F6         &kp F7   &kp F8   &kp LC(PAUSE_BREAK)    &kp LS(LG(LEFT_ARROW))  &kp LEFT           &kp DOWN  &kp UP         &kp RIGHT  &trans           &trans
&trans     &kp F9     &kp F10        &kp F11  &kp F12  &kp C_AC_BACK          &kp LS(LG(RIGHT))       &kp C_VOLUME_DOWN  &kp END   &kp PAGE_DOWN  &kp DEL    &trans           &trans
&trans     &trans     &trans         &trans   &trans   &trans                 &trans                  &trans             &trans    &trans         &trans     &trans
            >;

            label = "NavAndFunction";
        };

        NumAndSymbols {
            bindings = <
&trans     &none            &none        &none           &none         &none                   &trans  &none                  &none         &none         &none         &none          &trans
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH        &kp DOLLAR    &kp LEFT_BRACE          &trans  &kp RIGHT_BRACE        &kp N7        &kp N8        &kp N9        &kp BACKSLASH  &trans
&trans     &kp PERCENT      &kp CARET    &kp AMPERSAND   &kp ASTERISK  &kp LEFT_BRACKET        &trans  &kp RIGHT_BRACKET      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PIPE       &trans
&trans     &kp PLUS         &kp EQUAL    &kp UNDERSCORE  &kp MINUS     &kp LEFT_PARENTHESIS    &trans  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0         &trans
&trans     &trans           &trans       &trans          &trans        &trans                  &trans  &trans                 &trans        &trans        &trans        &trans
            >;

            label = "NumAndSymbols";
        };

        DeviceCtrl {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_COLOR_HSB(0,64,76)  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &trans  &trans           &trans                          &trans           &trans           &trans           &trans
&trans  &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &trans  &trans           &trans                          &trans           &trans           &trans           &trans
&trans  &sys_reset    &trans          &bootloader   &trans        &trans          &trans  &trans           &trans                          &sys_reset       &soft_off        &bootloader      &trans
&trans  &trans        &trans          &trans        &trans        &trans          &trans  &trans           &trans                          &trans           &trans           &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "DeviveCtrl";
        };

        OSLMacros {
            bindings = <
&none  &none             &none              &none          &none            &none    &none  &none  &none  &none  &none  &none  &none
&none  &none             &none              &none          &kp LA(F4)       &none    &none  &none  &none  &none  &none  &none  &none
&none  &kp LA(P)         &kp LC(S)          &kp LC(LS(S))  &kp LC(LS(F))    &none    &none  &none  &none  &none  &none  &none  &none
&none  &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &none          &kp LC(LA(F11))  &none    &none  &none  &none  &none  &none  &none  &none
&none  &none             &none              &none          &none            &none    &none  &none  &none  &none  &none  &none
            >;

            label = "OSLMacros";
        };

        VS_rh {
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &none   &none    &none    &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none   &none    &none    &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &kp F9  &kp F10  &kp F11  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none   &none    &none    &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none   &none    &none    &none  &none
            >;

            label = "VS_rh";
        };

        Gaming {
            label = "Gaming";
            display-name = "Gaming";
            bindings = <
&kp ESCAPE  &kp N1  &kp N2        &kp N3     &kp N4     &kp N5          &msc SCRL_UP     &kp N6     &kp N7        &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp ESCAPE  &kp Q   &kp W         &kp E      &kp R      &kp T           &msc SCRL_DOWN   &kp Y      &kp U         &kp I      &kp O    &kp P     &kp BACKSPACE
&kp TAB     &kp A   &kp S         &kp D      &kp F      &kp G           &msc SCRL_LEFT   &kp H      &kp J         &kp K      &kp L    &kp SEMI  &mt LEFT_ALT SQT
&kp LSHFT   &kp Z   &kp X         &kp C      &kp V      &kp B           &msc SCRL_RIGHT  &kp N      &kp M         &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
&kp C_MUTE  &none   &kp LEFT_ALT  &kp LCTRL  &kp SPACE  &kp LEFT_GUI    &mkp MB3         &kp ENTER  &tlt 2 SPACE  &none      &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };
};
